<% content_for :title, "#{@work.title} — #{@work.author}" %>
<article class="work">
  <header class="work-header">
    <h2><%= @work.title %></h2>
    <p class="work-author"><%= @work.author %> · <%= link_to "青空文庫の図書カード", @work.card_url %></p>
  </header>

  <% @work.paragraphs.each do |paragraph| %>
    <p class="work-paragraph" id="p<%= paragraph.position %>"><%= paragraph.body %></p>
  <% end %>

  <% if @work.colophon.present? %>
    <footer class="work-colophon"><pre><%= @work.colophon %></pre></footer>
  <% end %>
</article>
