<section class="column strategy-<%= column.strategy.key %>" id="strategy-<%= column.strategy.key %>">
  <header class="column-header">
    <h2><span class="strategy-dot" aria-hidden="true"></span><%= link_to column.strategy.title, tokenizers_path(anchor: column.strategy.key), class: "column-title", title: "How the #{column.strategy.key} tokenizer works" %></h2>
    <p class="column-summary"><%= column.strategy.summary %></p>
    <pre class="migration"><code><%= column.strategy.migration_line %></code></pre>
    <p class="tokens">
      <span class="tokens-label">Query as FTS5 tokens:</span>
      <%= token_chips column.tokens, empty: "none" %>
      <%= link_to "try it in the playground", tokenizers_path(q: column.query, anchor: "playground"), class: "tokens-playground" %>
    </p>
  </header>

  <% if column.error %>
    <p class="column-error"><%= column.error %></p>
  <% elsif column.results.total.zero? %>
    <p class="column-count">0 hits</p>
  <% else %>
    <p class="column-count"><%= pluralize number_with_delimiter(column.results.total), "hit" %><%= ", showing the first #{column.results.size}" if column.results.total > column.results.size %></p>
    <ol class="hits">
      <% column.results.each do |section| %>
        <li class="hit">
          <p class="hit-title">
            <span class="hit-guide"><%= section.guide_title %></span>
            <%= link_to section.hit.highlight(:title) || section.title, section.url, class: "hit-link" %>
          </p>
          <p class="hit-body"><%= section.hit.highlight(:body) || truncate(section.body, length: 200) %></p>
          <p class="hit-meta">
            <% if section.parent_title %><span class="hit-parent">in <%= section.parent_title %></span><% end %>
            <span class="hit-score" title="FTS5 bm25 rank, lower is better">rank <%= number_with_precision section.hit.score, precision: 3 %></span>
          </p>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
