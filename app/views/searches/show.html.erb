<%= form_with url: root_path, method: :get, class: "search-form", data: { turbo_frame: "_top" } do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "検索語を入力 (e.g. ごん, 山猫, メロス)", autofocus: true, class: "search-input", lang: "ja" %>
  <%= form.select :author, options_for_select([ [ "全著者", "" ] ] + @authors.map { |a| [ a, a ] }, @author), {}, class: "search-author" %>
  <%= form.submit "Search", class: "search-submit" %>
<% end %>

<p class="samples">
  Try:
  <% @sample_queries.each do |sample| %>
    <%= link_to sample, root_path(q: sample, author: @author), class: "sample" %>
  <% end %>
</p>

<% if @columns.empty? %>
  <section class="intro">
    <p>
      Each column below is one Active Search index over the same <%= number_with_delimiter Paragraph.count %> paragraphs
      of <%= Work.count %> short stories. They differ in one line of their migration, the FTS5 tokenizer,
      and the third one also splits the text into words before indexing it.
    </p>
    <p>
      Search for a two-character word like <%= link_to "ごん", root_path(q: "ごん") %> to see trigram miss it,
      a word inside a sentence like <%= link_to "ゴーシュ", root_path(q: "ゴーシュ") %> to see unicode61 miss it,
      or <%= link_to "料理店", root_path(q: "料理店") %> to see the word splitter disagree with you.
    </p>
  </section>
<% else %>
  <div class="columns">
    <% @columns.each do |column| %>
      <%= render "column", column: column %>
    <% end %>
  </div>
<% end %>
