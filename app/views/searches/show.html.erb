<%= form_with url: root_path, method: :get, class: "search-form", data: { controller: "clean-params", action: "submit->clean-params#submit" } do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "Search the Rails Guides (e.g. callbacks, has_many, deprecat)", autofocus: true, class: "search-input" %>
  <%= form.select :guide, options_for_select([ [ "All guides", "" ] ] + @guides.map { |g| [ g.title, g.id ] }, @guide&.id), {}, class: "search-guide" %>
  <%# No name, so the button's value does not travel in the URL as commit=Search. %>
  <%= form.submit "Search", name: nil, class: "search-submit" %>
<% end %>

<p class="samples">
  Try:
  <% @sample_queries.each do |sample| %>
    <%= link_to sample, root_path(q: sample, guide: @guide&.id), class: "sample" %>
  <% end %>
</p>

<% if @columns.empty? %>
  <section class="intro">
    <p>
      Each column below is one Active Search index over the same <%= number_with_delimiter Section.count %> sections
      of <%= Guide.count %> Rails Guides. The indexes differ in one line of their migration, the FTS5 tokenizer.
    </p>
    <p>
      Search for <%= link_to "callbacks", root_path(q: "callbacks") %> to see the default tokenizer skip the
      sections that say "callback", for <%= link_to "validate", root_path(q: "validate") %> to see the Porter stemmer
      fold a word's forms together, for <%= link_to "deprecat", root_path(q: "deprecat") %> to see only trigram match
      part of a word, or for <%= link_to "has_many", root_path(q: "has_many") %> to see the default tokenizer
      read it as the two words "has many".
    </p>
    <p>
      <%= link_to "How the three tokenizers differ", tokenizers_path %> explains what a tokenizer does to the
      text and to your query, with a playground to try your own.
    </p>
  </section>
<% else %>
  <div class="columns">
    <% @columns.each do |column| %>
      <%= render "column", column: column %>
    <% end %>
  </div>
<% end %>
